rules_version = '2';

// Progress lives at users/{uid}, one document per account. System design
// diagrams live beneath it at users/{uid}/designs/{chapterId}, one per chapter.
//
// This is the only thing standing between your notes and the internet: the
// Firebase config in the client bundle is public, so these rules — not the
// config — are what keep other people out. Nothing is readable or writable
// without being signed in as the owner of the document.
//
// The `{document=**}` wildcard matters: a rule on users/{userId} covers that
// document alone and does not cascade to subcollections beneath it. Without it
// every design read and write is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
