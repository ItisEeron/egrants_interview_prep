# Copy to server/.env and adjust as needed.

PORT=4000

# "local" writes to server/data/progress.json.
# "google-drive" is stubbed — see server/src/storage/googleDriveAdapter.js.
STORAGE_DRIVER=local

# Only needed once STORAGE_DRIVER=google-drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FILE_NAME=egrants-interview-prep-progress.json
